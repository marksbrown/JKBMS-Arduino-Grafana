// Copy this file to arduino_secrets.h and fill in your values.
// arduino_secrets.h is gitignored and must never be committed.

// WiFi credentials
#define SECRET_SSID "your_wifi_ssid"
#define SECRET_PASS "your_wifi_password"

// HTTP Basic Auth for MaxScale API
#define SECRET_HTTPUSER "your_http_username"
#define SECRET_HTTPAUTH "your_http_password"

// MariaDB / MaxScale connection details
#define SECRET_DBTARGET "your_mariadb_server_address"
#define SECRET_DB       "your_database_name"
#define SECRET_DBTABLE  "bms"
#define SECRET_DBUSER   "your_db_username"
#define SECRET_DBPASS   "your_db_password"
